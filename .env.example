# Reference only: the adapter does not load this file automatically.
# Export these variables in the shell that starts DeepSeek Harness.
# Windows paths may use values such as D:\projects\MediaCrawler.

# Required: separate MediaCrawler source checkout.
MEDIACRAWLER_ROOT=/absolute/path/to/MediaCrawler

# Recommended: Python executable from the adapter's dedicated environment.
# When omitted, the bundle falls back to the dsh-mediacrawler-mcp command on PATH.
DSH_MEDIACRAWLER_PYTHON=/absolute/path/to/dsh-mediacrawler-venv/bin/python

# Optional: Python executable from MediaCrawler's prepared environment.
MEDIACRAWLER_PYTHON=/absolute/path/to/MediaCrawler/.venv/bin/python

# Optional: adapter state, logs, run data, and exports.
DSH_MEDIACRAWLER_STATE_DIR=/absolute/path/to/dsh-mediacrawler-state
